#define _CRT_SECURE_NO_DEPRECATE
#define _USE_MATH_DEFINES
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <locale.h>

void zadanie1(void)
{
    int gr;

    puts("=== Задание 1 ===");
    puts("Введите угол в градусах:");
    scanf("%d", &gr);

    printf("sin(%d град) = %.6f\n", gr, sin(gr * M_PI / 180));
    puts("");
}

void zadanie2(void)
{
    double k = 7, x, a, b, y;
    int A, B, C;

    puts("=== Задание 2 ===");
    puts("Введите x:");
    scanf("%lf", &x);

    a = pow(k + x, 3);
    b = log10(fabs(k * x));
    y = b * b + sqrt(fabs(a));

    printf("x = %.3f, y = %.3f\n", x, y);
    puts("");

    puts("=== Задание 3 ===");
    A = (int)a;
    B = (int)b;
    C = (int)y;

    printf("а) условие выполнено (1 - да, 0 - нет): %d\n", (A % 2 == 0) != (B % 2 == 0));
    printf("б) условие выполнено (1 - да, 0 - нет): %d\n", A % 3 == 0 && B % 3 == 0 && C % 3 == 0);
    puts("");
}

void homework(void)
{
    double x, y, res;

    puts("=== Домашнее задание 5.2 === Вариант 9");
    puts("Введите x и y:");
    scanf("%lf %lf", &x, &y);

    res = cos(2 * x) / (M_PI + 3 * x) - 8 * x * sin(x * y) + 5;

    printf("Ответ %.3f\n", res);
    puts("");
}

int main(void)
{
    setlocale(LC_CTYPE, "rus");

    zadanie1();
    zadanie2();
    homework();

    system("pause");
    return 0;
}
